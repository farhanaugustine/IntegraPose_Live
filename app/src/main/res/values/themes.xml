<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.IntegraPose" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.IntegraPose.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/brand_splash_navy</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/brand_splash_navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.IntegraPose.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/brand_launcher_artwork</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.IntegraPose</item>
    </style>

</resources>
